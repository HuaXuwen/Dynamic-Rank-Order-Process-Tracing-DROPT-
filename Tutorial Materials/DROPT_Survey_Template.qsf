{"SurveyEntry":{"SurveyID":"SV_3IvOaR2kfI40hw2","SurveyName":"DROPT_Survey_Template","SurveyDescription":null,"SurveyOwnerID":"UR_2ldEuecE5msvoIS","SurveyBrandID":"wharton","DivisionID":null,"SurveyLanguage":"EN","SurveyActiveResponseSet":"RS_1LACm8ibrsQWvbM","SurveyStatus":"Inactive","SurveyStartDate":"0000-00-00 00:00:00","SurveyExpirationDate":"0000-00-00 00:00:00","SurveyCreationDate":"2025-09-07 08:35:16","CreatorID":"UR_2ldEuecE5msvoIS","LastModified":"2026-07-01 04:23:18","LastAccessed":"0000-00-00 00:00:00","LastActivated":"0000-00-00 00:00:00","Deleted":null},"SurveyElements":[{"SurveyID":"SV_3IvOaR2kfI40hw2","Element":"BL","PrimaryAttribute":"Survey Blocks","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":[{"Type":"Default","Description":"DROPT Ranking","ID":"BL_bfsQC942fuA1Qiy","BlockElements":[{"Type":"Question","QuestionID":"QID1"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID5"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID6"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID7"}]},{"Type":"Trash","Description":"Trash \/ Unused Questions","ID":"BL_9MkY2v1Y1TSA2AC","BlockElements":[{"Type":"Question","QuestionID":"QID4"},{"Type":"Question","QuestionID":"QID2"},{"Type":"Question","QuestionID":"QID9"},{"Type":"Question","QuestionID":"QID8"}]},{"Type":"Standard","SubType":"","Description":"End","ID":"BL_3ki39za6qEbNrD0","BlockElements":[{"Type":"Question","QuestionID":"QID3"}]}]},{"SurveyID":"SV_3IvOaR2kfI40hw2","Element":"FL","PrimaryAttribute":"Survey Flow","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"Type":"Root","FlowID":"FL_1","Flow":[{"Type":"EmbeddedData","FlowID":"FL_3","EmbeddedData":[{"Description":"DROPT_RankProcess","Type":"Recipient","Field":"DROPT_RankProcess","VariableType":"String","DataVisibility":[],"AnalyzeText":false},{"Description":"DROPT_TaskMetadata","Type":"Recipient","Field":"DROPT_TaskMetadata","VariableType":"String","DataVisibility":[],"AnalyzeText":false},{"Description":"DROPT_TaskCount","Type":"Custom","Field":"DROPT_TaskCount","VariableType":"String","DataVisibility":[],"AnalyzeText":false,"Value":"0"},{"Description":"DROPT_Submitted","Type":"Recipient","Field":"DROPT_Submitted","VariableType":"String","DataVisibility":[],"AnalyzeText":false}]},{"Type":"Block","ID":"BL_bfsQC942fuA1Qiy","FlowID":"FL_2","Autofill":[]},{"Type":"Standard","ID":"BL_3ki39za6qEbNrD0","FlowID":"FL_5","Autofill":[]},{"Type":"EndSurvey","FlowID":"FL_4"}],"Properties":{"Count":5}}},{"SurveyID":"SV_3IvOaR2kfI40hw2","Element":"PL","PrimaryAttribute":"Preview Link","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"PreviewType":"Public","PreviewID":"7e2e29f0-6cc4-45d7-b61d-ad60f204b9a6"}},{"SurveyID":"SV_3IvOaR2kfI40hw2","Element":"PROJ","PrimaryAttribute":"CORE","SecondaryAttribute":null,"TertiaryAttribute":"1.1.0","Payload":{"ProjectCategory":"CORE","SchemaVersion":"1.1.0"}},{"SurveyID":"SV_3IvOaR2kfI40hw2","Element":"QC","PrimaryAttribute":"Survey Question Count","SecondaryAttribute":"9","TertiaryAttribute":null,"Payload":null},{"SurveyID":"SV_3IvOaR2kfI40hw2","Element":"RS","PrimaryAttribute":"RS_1LACm8ibrsQWvbM","SecondaryAttribute":"Default Response Set","TertiaryAttribute":null,"Payload":null},{"SurveyID":"SV_3IvOaR2kfI40hw2","Element":"SCO","PrimaryAttribute":"Scoring","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"ScoringCategories":[],"ScoringCategoryGroups":[],"ScoringSummaryCategory":null,"ScoringSummaryAfterQuestions":0,"ScoringSummaryAfterSurvey":0,"DefaultScoringCategory":null,"AutoScoringCategory":null}},{"SurveyID":"SV_3IvOaR2kfI40hw2","Element":"SO","PrimaryAttribute":"Survey Options","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"BackButton":"false","SaveAndContinue":"true","SurveyProtection":"PublicSurvey","BallotBoxStuffingPrevention":"false","NoIndex":"Yes","SecureResponseFiles":"true","SurveyExpiration":"None","SurveyTermination":"DefaultMessage","Header":"","Footer":"","ProgressBarDisplay":"None","PartialData":"+1 week","ValidationMessage":null,"PreviousButton":" \u2190 ","NextButton":" \u2192 ","SurveyTitle":"Qualtrics Survey | Qualtrics Experience Management","SkinLibrary":"wharton","SkinType":"templated","Skin":{"brandingId":null,"templateId":"*base","overrides":null},"NewScoring":1,"SurveyMetaDescription":"The most powerful, simple and trusted way to gather experience data. Start your journey to experience management and try a free account today.","EOSMessage":null,"ShowExportTags":"false","CollectGeoLocation":"false","PasswordProtection":"No","AnonymizeResponse":"Yes","RefererCheck":"No","BallotBoxStuffingPreventionBehavior":null,"BallotBoxStuffingPreventionMessage":null,"BallotBoxStuffingPreventionMessageLibrary":null,"BallotBoxStuffingPreventionURL":null,"RecaptchaV3":"false","ConfirmStart":false,"AutoConfirmStart":false,"RelevantID":"false","RelevantIDLockoutPeriod":"+30 days","UseCustomSurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessageLibrary":null,"ResponseSummary":"No","EOSMessageLibrary":null,"EOSRedirectURL":null,"EmailThankYou":"false","ThankYouEmailMessageLibrary":null,"ThankYouEmailMessage":null,"ValidateMessage":"false","ValidationMessageLibrary":null,"InactiveSurvey":"DefaultMessage","PartialDeletion":null,"PartialDataCloseAfter":"LastActivity","InactiveMessageLibrary":null,"InactiveMessage":null,"AvailableLanguages":{"EN":[]},"SurveyName":"DROPT_Survey_Template"}},{"SurveyID":"SV_3IvOaR2kfI40hw2","Element":"SQ","PrimaryAttribute":"QID1","SecondaryAttribute":"Hello! Below you will see three ranking blocks, which already include the appropriate Java Script...","TertiaryAttribute":null,"Payload":{"QuestionText":"Hello!<br \/>\n<br \/>\nBelow you will see three ranking blocks, which already include the appropriate Java Script to collect DROPT data. The embedded data fields have already been added to the survey flow.&nbsp;<br \/>\n<br \/>\nIf you have any questions on how to use this template, feel free to reach out to the authors of the OSF (link <a href=\"https:\/\/osf.io\/vaycw\/overview?view_only=f7fe74ff872546cf8fc6841c94ed93c4\">here<\/a>).<br \/>\n<br \/>\nHave fun collecting data!","DefaultChoices":false,"DataExportTag":"intro","QuestionID":"QID1","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Hello! Below you will see three ranking blocks, which already include the appropriate Java Script...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_3IvOaR2kfI40hw2","Element":"SQ","PrimaryAttribute":"QID2","SecondaryAttribute":"This is the rank-order question with some mock items. If any of the rank-order items are dragged...","TertiaryAttribute":null,"Payload":{"QuestionText":"This is the rank-order question with some mock items. If any of the rank-order items are dragged and dropped (and, importantly, change position!), this will be recorded in the embedded data fields. Once you download the data, all DROPT data will be downloaded as well.","QuestionJS":"\/\/ DROPT JavaScript: question-level cumulative logger\n\/\/\n\/\/ Placement: paste this SAME script into the JavaScript editor for each\n\/\/ Qualtrics rank-order question that should be recorded by DROPT.\n\/\/\n\/\/ Required Embedded Data fields in Survey Flow, before the rank-order questions:\n\/\/   DROPT_RankProcess\n\/\/   DROPT_TaskMetadata\n\/\/   DROPT_TaskCount\n\/\/   DROPT_Submitted\n\/\/\n\/\/ Main log format:\n\/\/   {DROPT1|0|NA|1,2,3,4,5}\n\/\/   {DROPT1|412,980|5|1,2,5,3,4}\n\/\/\n\/\/ Entry fields are:\n\/\/   {task_id|timing|item_moved|current_order}\n\/\/\n\/\/ The script records a drag only when that drag changes the final rank order.\n\/\/ If an item is picked up and dropped back into the same position, that touch\n\/\/ is ignored.\n\nQualtrics.SurveyEngine.addOnload(function () {\n  var q = this;\n\n  var CONFIG = {\n    taskPrefix: \"DROPT\",\n    processField: \"DROPT_RankProcess\",\n    metadataField: \"DROPT_TaskMetadata\",\n    taskCountField: \"DROPT_TaskCount\",\n    submittedField: \"DROPT_Submitted\",\n    delayMs: 200,\n    debug: false\n  };\n\n  var STORAGE_PREFIX = \"DROPT_CUMULATIVE_\";\n  var KEY_COUNT = STORAGE_PREFIX + \"task_count\";\n  var KEY_MAP = STORAGE_PREFIX + \"task_map\";\n  var KEY_PROCESS = STORAGE_PREFIX + CONFIG.processField;\n  var KEY_METADATA = STORAGE_PREFIX + CONFIG.metadataField;\n\n  var submitted = 0;\n  var rankCountThisQuestion = 0;\n  var startTime = new Date().getTime();\n  var mouseDownTime = null;\n  var orderAtDragStart = null;\n  var itemMovedAtStart = null;\n  var dragInProgress = false;\n  var lastTouchStartWallTime = 0;\n\n  var questionId = getQuestionId(q);\n  var namespace = \".dropt_\" + questionId.replace(\/[^A-Za-z0-9_\\-]\/g, \"_\");\n\n  if (window.__DROPT_question_level_initialized === undefined) {\n    window.__DROPT_question_level_initialized = {};\n  }\n  if (window.__DROPT_question_level_initialized[questionId]) {\n    log(\"DROPT already initialized for this question on this page:\", questionId);\n    return;\n  }\n  window.__DROPT_question_level_initialized[questionId] = true;\n\n  var $question = getQuestionContainer(q, questionId);\n  var taskId = assignChronologicalTaskId(questionId);\n\n  initializeQuestion();\n\n  function initializeQuestion() {\n    var initialOrder = getCurrentOrder();\n\n    if (!validOrder(initialOrder)) {\n      log(\"DROPT did not find a valid rank order at load for\", questionId, initialOrder);\n      return;\n    }\n\n    appendInitialStateOnce(taskId, questionId, initialOrder);\n    setEmbeddedData(CONFIG.taskCountField, getStored(KEY_COUNT, \"0\"));\n    setEmbeddedData(CONFIG.submittedField, \"0\");\n    flushStoredLogsToEmbeddedData();\n\n    log(\"DROPT initialized\", {\n      taskId: taskId,\n      questionId: questionId,\n      initialOrder: initialOrder\n    });\n  }\n\n  function getQuestionId(questionObject) {\n    if (questionObject && questionObject.questionId) {\n      return String(questionObject.questionId);\n    }\n    if (questionObject && questionObject.getQuestionInfo) {\n      try {\n        var info = questionObject.getQuestionInfo();\n        if (info && info.QuestionID) return String(info.QuestionID);\n      } catch (e) {}\n    }\n    return \"DROPT_Q_\" + Math.floor(Math.random() * 1000000000);\n  }\n\n  function getQuestionContainer(questionObject, qid) {\n    var $container = jQuery();\n\n    if (questionObject && questionObject.getQuestionContainer) {\n      try {\n        $container = jQuery(questionObject.getQuestionContainer());\n      } catch (e) {}\n    }\n\n    if (!$container || $container.length === 0) {\n      $container = jQuery(\"#\" + qid);\n    }\n\n    \/\/ Final fallback: use the document, matching the original DROPT script.\n    if (!$container || $container.length === 0) {\n      $container = jQuery(document);\n    }\n\n    return $container;\n  }\n\n  function log() {\n    if (CONFIG.debug && window.console && console.log) {\n      console.log.apply(console, arguments);\n    }\n  }\n\n  function getElapsedTime() {\n    return new Date().getTime() - startTime;\n  }\n\n  function hasScopedRankHandles() {\n    return $question && $question.length > 0 && $question.find(\"li.ui-sortable-handle\").length > 0;\n  }\n\n  function handleBelongsToThisQuestion($handle) {\n    if (!hasScopedRankHandles()) return true;\n    return $question[0] === $handle[0] || jQuery.contains($question[0], $handle[0]);\n  }\n\n  function getChoiceIdFromElement(el) {\n    var $li = jQuery(el).closest(\"li.ui-sortable-handle\");\n    var choiceId = $li.attr(\"data-choiceid\");\n    if (choiceId === undefined || choiceId === null || choiceId === \"\") {\n      choiceId = $li.data(\"choiceid\");\n    }\n    if (choiceId === undefined || choiceId === null || choiceId === \"\") {\n      choiceId = $li.attr(\"choiceid\");\n    }\n    return String(choiceId);\n  }\n\n  function getCurrentOrder() {\n    var order = [];\n    var $handles = jQuery();\n\n    if (hasScopedRankHandles()) {\n      $handles = $question.find(\"li.ui-sortable-handle\");\n    } else {\n      \/\/ Fallback to the original DROPT selector.\n      $handles = jQuery(\"li.ui-sortable-handle\");\n    }\n\n    $handles.each(function () {\n      var choiceId = jQuery(this).attr(\"data-choiceid\");\n      if (choiceId === undefined || choiceId === null || choiceId === \"\") {\n        choiceId = jQuery(this).data(\"choiceid\");\n      }\n      if (choiceId !== undefined && choiceId !== null && String(choiceId) !== \"\") {\n        order.push(String(choiceId));\n      }\n    });\n\n    return order;\n  }\n\n  function arraysEqual(a, b) {\n    if (!a || !b) return false;\n    if (a.length !== b.length) return false;\n    for (var i = 0; i < a.length; i++) {\n      if (String(a[i]) !== String(b[i])) return false;\n    }\n    return true;\n  }\n\n  function validOrder(order) {\n    if (!order || order.length < 2) return false;\n    var seen = {};\n    for (var i = 0; i < order.length; i++) {\n      var value = String(order[i]);\n      if (value === \"\" || value === \"undefined\" || value === \"null\") return false;\n      if (seen[value]) return false;\n      seen[value] = true;\n    }\n    return true;\n  }\n\n  function escapeRegExp(s) {\n    return String(s).replace(\/[.*+?^${}()|[\\]\\\\]\/g, \"\\\\$&\");\n  }\n\n  function getStored(key, defaultValue) {\n    try {\n      var x = sessionStorage.getItem(key);\n      if (x !== null && x !== undefined) return x;\n    } catch (e) {}\n    return defaultValue;\n  }\n\n  function setStored(key, value) {\n    try {\n      sessionStorage.setItem(key, String(value));\n    } catch (e) {}\n  }\n\n  function getTaskMap() {\n    var raw = getStored(KEY_MAP, \"{}\");\n    try {\n      return JSON.parse(raw) || {};\n    } catch (e) {\n      return {};\n    }\n  }\n\n  function setTaskMap(map) {\n    setStored(KEY_MAP, JSON.stringify(map));\n  }\n\n  function assignChronologicalTaskId(qid) {\n    var map = getTaskMap();\n    if (map[qid]) {\n      return map[qid];\n    }\n\n    var count = parseInt(getStored(KEY_COUNT, \"0\"), 10);\n    if (isNaN(count)) count = 0;\n    count += 1;\n\n    var id = CONFIG.taskPrefix + count;\n    map[qid] = id;\n    setTaskMap(map);\n    setStored(KEY_COUNT, count);\n    return id;\n  }\n\n  function appendToStoredLog(key, entry) {\n    var current = getStored(key, \"\");\n    current = current ? current + \" \" + entry : entry;\n    setStored(key, current);\n    return current;\n  }\n\n  function setEmbeddedData(field, value) {\n    try {\n      Qualtrics.SurveyEngine.setEmbeddedData(field, String(value));\n    } catch (e) {\n      log(\"DROPT could not set embedded data\", field, e);\n    }\n  }\n\n  function flushStoredLogsToEmbeddedData() {\n    setEmbeddedData(CONFIG.processField, getStored(KEY_PROCESS, \"\"));\n    setEmbeddedData(CONFIG.metadataField, getStored(KEY_METADATA, \"\"));\n    setEmbeddedData(CONFIG.taskCountField, getStored(KEY_COUNT, \"0\"));\n  }\n\n  function processEntry(task, timing, item, order) {\n    return \"{\" + task + \"|\" + timing + \"|\" + item + \"|\" + order.join(\",\") + \"}\";\n  }\n\n  function metadataEntry(task, qid, order) {\n    return \"{\" + task + \"|\" + qid + \"|\" + order.join(\",\") + \"}\";\n  }\n\n  function storedLogHasInitial(task) {\n    var raw = getStored(KEY_PROCESS, \"\");\n    var pattern = new RegExp(\"\\\\{\" + escapeRegExp(task) + \"\\\\|0\\\\|NA\\\\|\");\n    return pattern.test(raw);\n  }\n\n  function storedMetadataHasTask(task) {\n    var raw = getStored(KEY_METADATA, \"\");\n    var pattern = new RegExp(\"\\\\{\" + escapeRegExp(task) + \"\\\\|\");\n    return pattern.test(raw);\n  }\n\n  function appendInitialStateOnce(task, qid, order) {\n    if (!validOrder(order)) return;\n\n    if (!storedLogHasInitial(task)) {\n      var initial = processEntry(task, \"0\", \"NA\", order);\n      appendToStoredLog(KEY_PROCESS, initial);\n      log(\"DROPT recorded initial order:\", initial);\n    }\n\n    if (!storedMetadataHasTask(task)) {\n      var metadata = metadataEntry(task, qid, order);\n      appendToStoredLog(KEY_METADATA, metadata);\n      log(\"DROPT recorded task metadata:\", metadata);\n    }\n  }\n\n  function startDrag(event) {\n    if (submitted === 1) return;\n\n    \/\/ Some touch devices fire a mouse event immediately after a touch event.\n    \/\/ Ignore that synthetic mouse start.\n    var now = new Date().getTime();\n    if (event.type === \"mousedown\" && now - lastTouchStartWallTime < 500) {\n      return;\n    }\n    if (event.type === \"touchstart\") {\n      lastTouchStartWallTime = now;\n    }\n\n    var $handle = jQuery(event.target).closest(\"li.ui-sortable-handle\");\n    if ($handle.length === 0) return;\n    if (!handleBelongsToThisQuestion($handle)) return;\n\n    var currentOrder = getCurrentOrder();\n    if (!validOrder(currentOrder)) {\n      log(\"DROPT drag start ignored because current order is invalid:\", currentOrder);\n      return;\n    }\n\n    dragInProgress = true;\n    mouseDownTime = getElapsedTime();\n    orderAtDragStart = currentOrder.slice();\n    itemMovedAtStart = getChoiceIdFromElement($handle);\n\n    log(\"DROPT drag start\", {\n      taskId: taskId,\n      item: itemMovedAtStart,\n      time: mouseDownTime,\n      orderAtDragStart: orderAtDragStart\n    });\n  }\n\n  function endDrag() {\n    if (submitted === 1) return;\n    if (!dragInProgress) return;\n\n    dragInProgress = false;\n\n    var thisMouseDownTime = mouseDownTime;\n    var thisMouseUpTime = getElapsedTime();\n    var thisOrderAtDragStart = orderAtDragStart ? orderAtDragStart.slice() : null;\n    var thisItemMoved = itemMovedAtStart;\n\n    setTimeout(function () {\n      var finalOrder = getCurrentOrder();\n\n      if (!validOrder(finalOrder) || !validOrder(thisOrderAtDragStart)) {\n        log(\"DROPT drag end ignored because order was invalid\", {\n          before: thisOrderAtDragStart,\n          final: finalOrder\n        });\n        return;\n      }\n\n      \/\/ Record this drag only if this drag changed the final rank order.\n      if (arraysEqual(finalOrder, thisOrderAtDragStart)) {\n        log(\"DROPT no rank-order change. Touch ignored.\", {\n          taskId: taskId,\n          item: thisItemMoved,\n          before: thisOrderAtDragStart,\n          final: finalOrder\n        });\n        return;\n      }\n\n      rankCountThisQuestion += 1;\n\n      var timing = String(thisMouseDownTime) + \",\" + String(thisMouseUpTime);\n      var entry = processEntry(taskId, timing, thisItemMoved, finalOrder);\n\n      appendToStoredLog(KEY_PROCESS, entry);\n      flushStoredLogsToEmbeddedData();\n\n      log(\"DROPT recorded rank-order change\", {\n        taskId: taskId,\n        rankCountThisQuestion: rankCountThisQuestion,\n        entry: entry\n      });\n    }, CONFIG.delayMs);\n  }\n\n  \/\/ Bind to the document, like the original DROPT script, but only start a drag\n  \/\/ when the mousedown\/touchstart begins on this question's rank-order handles.\n  jQuery(document).on(\"mousedown\" + namespace + \" touchstart\" + namespace, startDrag);\n  jQuery(document).on(\"mouseup\" + namespace + \" touchend\" + namespace, endDrag);\n\n  Qualtrics.SurveyEngine.addOnPageSubmit(function () {\n    submitted = 1;\n    setEmbeddedData(CONFIG.submittedField, \"1\");\n    flushStoredLogsToEmbeddedData();\n    log(\"DROPT page submit\", {\n      taskId: taskId,\n      RankProcess: getStored(KEY_PROCESS, \"\"),\n      TaskMetadata: getStored(KEY_METADATA, \"\")\n    });\n  });\n\n  Qualtrics.SurveyEngine.addOnUnload(function () {\n    try {\n      jQuery(document).off(namespace);\n    } catch (e) {}\n  });\n\n  \/\/ Testing helpers. In Qualtrics preview, open the browser console and run\n  \/\/ DROPT_debug() after a rank-order question loads.\n  window.DROPT_debug = function () {\n    return {\n      version: \"DROPT question-level cumulative no-all\",\n      questionId: questionId,\n      taskId: taskId,\n      handlesFoundInQuestion: $question.find(\"li.ui-sortable-handle\").length,\n      handlesFoundDocument: jQuery(\"li.ui-sortable-handle\").length,\n      currentOrder: getCurrentOrder(),\n      orderAtDragStart: orderAtDragStart,\n      rankProcess: getStored(KEY_PROCESS, \"\"),\n      taskMetadata: getStored(KEY_METADATA, \"\"),\n      taskCount: getStored(KEY_COUNT, \"0\")\n    };\n  };\n\n  window.DROPT_clearTestData = function () {\n    try {\n      Object.keys(sessionStorage)\n        .filter(function (k) { return k.indexOf(STORAGE_PREFIX) === 0; })\n        .forEach(function (k) { sessionStorage.removeItem(k); });\n    } catch (e) {}\n    setEmbeddedData(CONFIG.processField, \"\");\n    setEmbeddedData(CONFIG.metadataField, \"\");\n    setEmbeddedData(CONFIG.taskCountField, \"0\");\n    setEmbeddedData(CONFIG.submittedField, \"0\");\n    return \"DROPT test data cleared. Refresh\/restart the survey preview from the beginning.\";\n  };\n});\n\nQualtrics.SurveyEngine.addOnReady(function () {\n  if (window.console && console.log) {\n    console.log(\"DROPT question-level script ready.\");\n  }\n});","DefaultChoices":false,"DataExportTag":"ranking1","QuestionID":"QID2","QuestionType":"RO","Selector":"DND","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"This is the rank-order question with some mock items. If any of the rank-order items are dragged...","Choices":{"1":{"Display":"Item 1"},"2":{"Display":"Item 2"},"3":{"Display":"Item 3"},"4":{"Display":"Item 4"},"5":{"Display":"Item 5"},"6":{"Display":"Item 6"}},"ChoiceOrder":[1,2,3,4,5,6],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":4,"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"}}},{"SurveyID":"SV_3IvOaR2kfI40hw2","Element":"SQ","PrimaryAttribute":"QID3","SecondaryAttribute":"Done! Your DROPT data has been recorded. Click to finish the study.","TertiaryAttribute":null,"Payload":{"QuestionText":"Done! Your DROPT data has been recorded. Click to finish the study.","DefaultChoices":false,"DataExportTag":"end","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Done! Your DROPT data has been recorded. Click to finish the study.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID3"}},{"SurveyID":"SV_3IvOaR2kfI40hw2","Element":"SQ","PrimaryAttribute":"QID4","SecondaryAttribute":"This is the rank-order question with some mock items. If any of the rank-order items are dragged...","TertiaryAttribute":null,"Payload":{"QuestionText":"This is the rank-order question with some mock items. If any of the rank-order items are dragged and dropped (and, importantly, change position!), this will be recorded in the embedded data fields. Once you download the data, all DROPT data will be downloaded as well.","QuestionJS":"\/\/ DROPT JavaScript: question-level cumulative logger\n\/\/\n\/\/ Placement: paste this SAME script into the JavaScript editor for each\n\/\/ Qualtrics rank-order question that should be recorded by DROPT.\n\/\/\n\/\/ Required Embedded Data fields in Survey Flow, before the rank-order questions:\n\/\/   DROPT_RankProcess\n\/\/   DROPT_TaskMetadata\n\/\/   DROPT_TaskCount\n\/\/   DROPT_Submitted\n\/\/\n\/\/ Main log format:\n\/\/   {DROPT1|0|NA|1,2,3,4,5}\n\/\/   {DROPT1|412,980|5|1,2,5,3,4}\n\/\/\n\/\/ Entry fields are:\n\/\/   {task_id|timing|item_moved|current_order}\n\/\/\n\/\/ The script records a drag only when that drag changes the final rank order.\n\/\/ If an item is picked up and dropped back into the same position, that touch\n\/\/ is ignored.\n\nQualtrics.SurveyEngine.addOnload(function () {\n  var q = this;\n\n  var CONFIG = {\n    taskPrefix: \"DROPT\",\n    processField: \"DROPT_RankProcess\",\n    metadataField: \"DROPT_TaskMetadata\",\n    taskCountField: \"DROPT_TaskCount\",\n    submittedField: \"DROPT_Submitted\",\n    delayMs: 200,\n    debug: false\n  };\n\n  var STORAGE_PREFIX = \"DROPT_CUMULATIVE_\";\n  var KEY_COUNT = STORAGE_PREFIX + \"task_count\";\n  var KEY_MAP = STORAGE_PREFIX + \"task_map\";\n  var KEY_PROCESS = STORAGE_PREFIX + CONFIG.processField;\n  var KEY_METADATA = STORAGE_PREFIX + CONFIG.metadataField;\n\n  var submitted = 0;\n  var rankCountThisQuestion = 0;\n  var startTime = new Date().getTime();\n  var mouseDownTime = null;\n  var orderAtDragStart = null;\n  var itemMovedAtStart = null;\n  var dragInProgress = false;\n  var lastTouchStartWallTime = 0;\n\n  var questionId = getQuestionId(q);\n  var namespace = \".dropt_\" + questionId.replace(\/[^A-Za-z0-9_\\-]\/g, \"_\");\n\n  if (window.__DROPT_question_level_initialized === undefined) {\n    window.__DROPT_question_level_initialized = {};\n  }\n  if (window.__DROPT_question_level_initialized[questionId]) {\n    log(\"DROPT already initialized for this question on this page:\", questionId);\n    return;\n  }\n  window.__DROPT_question_level_initialized[questionId] = true;\n\n  var $question = getQuestionContainer(q, questionId);\n  var taskId = assignChronologicalTaskId(questionId);\n\n  initializeQuestion();\n\n  function initializeQuestion() {\n    var initialOrder = getCurrentOrder();\n\n    if (!validOrder(initialOrder)) {\n      log(\"DROPT did not find a valid rank order at load for\", questionId, initialOrder);\n      return;\n    }\n\n    appendInitialStateOnce(taskId, questionId, initialOrder);\n    setEmbeddedData(CONFIG.taskCountField, getStored(KEY_COUNT, \"0\"));\n    setEmbeddedData(CONFIG.submittedField, \"0\");\n    flushStoredLogsToEmbeddedData();\n\n    log(\"DROPT initialized\", {\n      taskId: taskId,\n      questionId: questionId,\n      initialOrder: initialOrder\n    });\n  }\n\n  function getQuestionId(questionObject) {\n    if (questionObject && questionObject.questionId) {\n      return String(questionObject.questionId);\n    }\n    if (questionObject && questionObject.getQuestionInfo) {\n      try {\n        var info = questionObject.getQuestionInfo();\n        if (info && info.QuestionID) return String(info.QuestionID);\n      } catch (e) {}\n    }\n    return \"DROPT_Q_\" + Math.floor(Math.random() * 1000000000);\n  }\n\n  function getQuestionContainer(questionObject, qid) {\n    var $container = jQuery();\n\n    if (questionObject && questionObject.getQuestionContainer) {\n      try {\n        $container = jQuery(questionObject.getQuestionContainer());\n      } catch (e) {}\n    }\n\n    if (!$container || $container.length === 0) {\n      $container = jQuery(\"#\" + qid);\n    }\n\n    \/\/ Final fallback: use the document, matching the original DROPT script.\n    if (!$container || $container.length === 0) {\n      $container = jQuery(document);\n    }\n\n    return $container;\n  }\n\n  function log() {\n    if (CONFIG.debug && window.console && console.log) {\n      console.log.apply(console, arguments);\n    }\n  }\n\n  function getElapsedTime() {\n    return new Date().getTime() - startTime;\n  }\n\n  function hasScopedRankHandles() {\n    return $question && $question.length > 0 && $question.find(\"li.ui-sortable-handle\").length > 0;\n  }\n\n  function handleBelongsToThisQuestion($handle) {\n    if (!hasScopedRankHandles()) return true;\n    return $question[0] === $handle[0] || jQuery.contains($question[0], $handle[0]);\n  }\n\n  function getChoiceIdFromElement(el) {\n    var $li = jQuery(el).closest(\"li.ui-sortable-handle\");\n    var choiceId = $li.attr(\"data-choiceid\");\n    if (choiceId === undefined || choiceId === null || choiceId === \"\") {\n      choiceId = $li.data(\"choiceid\");\n    }\n    if (choiceId === undefined || choiceId === null || choiceId === \"\") {\n      choiceId = $li.attr(\"choiceid\");\n    }\n    return String(choiceId);\n  }\n\n  function getCurrentOrder() {\n    var order = [];\n    var $handles = jQuery();\n\n    if (hasScopedRankHandles()) {\n      $handles = $question.find(\"li.ui-sortable-handle\");\n    } else {\n      \/\/ Fallback to the original DROPT selector.\n      $handles = jQuery(\"li.ui-sortable-handle\");\n    }\n\n    $handles.each(function () {\n      var choiceId = jQuery(this).attr(\"data-choiceid\");\n      if (choiceId === undefined || choiceId === null || choiceId === \"\") {\n        choiceId = jQuery(this).data(\"choiceid\");\n      }\n      if (choiceId !== undefined && choiceId !== null && String(choiceId) !== \"\") {\n        order.push(String(choiceId));\n      }\n    });\n\n    return order;\n  }\n\n  function arraysEqual(a, b) {\n    if (!a || !b) return false;\n    if (a.length !== b.length) return false;\n    for (var i = 0; i < a.length; i++) {\n      if (String(a[i]) !== String(b[i])) return false;\n    }\n    return true;\n  }\n\n  function validOrder(order) {\n    if (!order || order.length < 2) return false;\n    var seen = {};\n    for (var i = 0; i < order.length; i++) {\n      var value = String(order[i]);\n      if (value === \"\" || value === \"undefined\" || value === \"null\") return false;\n      if (seen[value]) return false;\n      seen[value] = true;\n    }\n    return true;\n  }\n\n  function escapeRegExp(s) {\n    return String(s).replace(\/[.*+?^${}()|[\\]\\\\]\/g, \"\\\\$&\");\n  }\n\n  function getStored(key, defaultValue) {\n    try {\n      var x = sessionStorage.getItem(key);\n      if (x !== null && x !== undefined) return x;\n    } catch (e) {}\n    return defaultValue;\n  }\n\n  function setStored(key, value) {\n    try {\n      sessionStorage.setItem(key, String(value));\n    } catch (e) {}\n  }\n\n  function getTaskMap() {\n    var raw = getStored(KEY_MAP, \"{}\");\n    try {\n      return JSON.parse(raw) || {};\n    } catch (e) {\n      return {};\n    }\n  }\n\n  function setTaskMap(map) {\n    setStored(KEY_MAP, JSON.stringify(map));\n  }\n\n  function assignChronologicalTaskId(qid) {\n    var map = getTaskMap();\n    if (map[qid]) {\n      return map[qid];\n    }\n\n    var count = parseInt(getStored(KEY_COUNT, \"0\"), 10);\n    if (isNaN(count)) count = 0;\n    count += 1;\n\n    var id = CONFIG.taskPrefix + count;\n    map[qid] = id;\n    setTaskMap(map);\n    setStored(KEY_COUNT, count);\n    return id;\n  }\n\n  function appendToStoredLog(key, entry) {\n    var current = getStored(key, \"\");\n    current = current ? current + \" \" + entry : entry;\n    setStored(key, current);\n    return current;\n  }\n\n  function setEmbeddedData(field, value) {\n    try {\n      Qualtrics.SurveyEngine.setEmbeddedData(field, String(value));\n    } catch (e) {\n      log(\"DROPT could not set embedded data\", field, e);\n    }\n  }\n\n  function flushStoredLogsToEmbeddedData() {\n    setEmbeddedData(CONFIG.processField, getStored(KEY_PROCESS, \"\"));\n    setEmbeddedData(CONFIG.metadataField, getStored(KEY_METADATA, \"\"));\n    setEmbeddedData(CONFIG.taskCountField, getStored(KEY_COUNT, \"0\"));\n  }\n\n  function processEntry(task, timing, item, order) {\n    return \"{\" + task + \"|\" + timing + \"|\" + item + \"|\" + order.join(\",\") + \"}\";\n  }\n\n  function metadataEntry(task, qid, order) {\n    return \"{\" + task + \"|\" + qid + \"|\" + order.join(\",\") + \"}\";\n  }\n\n  function storedLogHasInitial(task) {\n    var raw = getStored(KEY_PROCESS, \"\");\n    var pattern = new RegExp(\"\\\\{\" + escapeRegExp(task) + \"\\\\|0\\\\|NA\\\\|\");\n    return pattern.test(raw);\n  }\n\n  function storedMetadataHasTask(task) {\n    var raw = getStored(KEY_METADATA, \"\");\n    var pattern = new RegExp(\"\\\\{\" + escapeRegExp(task) + \"\\\\|\");\n    return pattern.test(raw);\n  }\n\n  function appendInitialStateOnce(task, qid, order) {\n    if (!validOrder(order)) return;\n\n    if (!storedLogHasInitial(task)) {\n      var initial = processEntry(task, \"0\", \"NA\", order);\n      appendToStoredLog(KEY_PROCESS, initial);\n      log(\"DROPT recorded initial order:\", initial);\n    }\n\n    if (!storedMetadataHasTask(task)) {\n      var metadata = metadataEntry(task, qid, order);\n      appendToStoredLog(KEY_METADATA, metadata);\n      log(\"DROPT recorded task metadata:\", metadata);\n    }\n  }\n\n  function startDrag(event) {\n    if (submitted === 1) return;\n\n    \/\/ Some touch devices fire a mouse event immediately after a touch event.\n    \/\/ Ignore that synthetic mouse start.\n    var now = new Date().getTime();\n    if (event.type === \"mousedown\" && now - lastTouchStartWallTime < 500) {\n      return;\n    }\n    if (event.type === \"touchstart\") {\n      lastTouchStartWallTime = now;\n    }\n\n    var $handle = jQuery(event.target).closest(\"li.ui-sortable-handle\");\n    if ($handle.length === 0) return;\n    if (!handleBelongsToThisQuestion($handle)) return;\n\n    var currentOrder = getCurrentOrder();\n    if (!validOrder(currentOrder)) {\n      log(\"DROPT drag start ignored because current order is invalid:\", currentOrder);\n      return;\n    }\n\n    dragInProgress = true;\n    mouseDownTime = getElapsedTime();\n    orderAtDragStart = currentOrder.slice();\n    itemMovedAtStart = getChoiceIdFromElement($handle);\n\n    log(\"DROPT drag start\", {\n      taskId: taskId,\n      item: itemMovedAtStart,\n      time: mouseDownTime,\n      orderAtDragStart: orderAtDragStart\n    });\n  }\n\n  function endDrag() {\n    if (submitted === 1) return;\n    if (!dragInProgress) return;\n\n    dragInProgress = false;\n\n    var thisMouseDownTime = mouseDownTime;\n    var thisMouseUpTime = getElapsedTime();\n    var thisOrderAtDragStart = orderAtDragStart ? orderAtDragStart.slice() : null;\n    var thisItemMoved = itemMovedAtStart;\n\n    setTimeout(function () {\n      var finalOrder = getCurrentOrder();\n\n      if (!validOrder(finalOrder) || !validOrder(thisOrderAtDragStart)) {\n        log(\"DROPT drag end ignored because order was invalid\", {\n          before: thisOrderAtDragStart,\n          final: finalOrder\n        });\n        return;\n      }\n\n      \/\/ Record this drag only if this drag changed the final rank order.\n      if (arraysEqual(finalOrder, thisOrderAtDragStart)) {\n        log(\"DROPT no rank-order change. Touch ignored.\", {\n          taskId: taskId,\n          item: thisItemMoved,\n          before: thisOrderAtDragStart,\n          final: finalOrder\n        });\n        return;\n      }\n\n      rankCountThisQuestion += 1;\n\n      var timing = String(thisMouseDownTime) + \",\" + String(thisMouseUpTime);\n      var entry = processEntry(taskId, timing, thisItemMoved, finalOrder);\n\n      appendToStoredLog(KEY_PROCESS, entry);\n      flushStoredLogsToEmbeddedData();\n\n      log(\"DROPT recorded rank-order change\", {\n        taskId: taskId,\n        rankCountThisQuestion: rankCountThisQuestion,\n        entry: entry\n      });\n    }, CONFIG.delayMs);\n  }\n\n  \/\/ Bind to the document, like the original DROPT script, but only start a drag\n  \/\/ when the mousedown\/touchstart begins on this question's rank-order handles.\n  jQuery(document).on(\"mousedown\" + namespace + \" touchstart\" + namespace, startDrag);\n  jQuery(document).on(\"mouseup\" + namespace + \" touchend\" + namespace, endDrag);\n\n  Qualtrics.SurveyEngine.addOnPageSubmit(function () {\n    submitted = 1;\n    setEmbeddedData(CONFIG.submittedField, \"1\");\n    flushStoredLogsToEmbeddedData();\n    log(\"DROPT page submit\", {\n      taskId: taskId,\n      RankProcess: getStored(KEY_PROCESS, \"\"),\n      TaskMetadata: getStored(KEY_METADATA, \"\")\n    });\n  });\n\n  Qualtrics.SurveyEngine.addOnUnload(function () {\n    try {\n      jQuery(document).off(namespace);\n    } catch (e) {}\n  });\n\n  \/\/ Testing helpers. In Qualtrics preview, open the browser console and run\n  \/\/ DROPT_debug() after a rank-order question loads.\n  window.DROPT_debug = function () {\n    return {\n      version: \"DROPT question-level cumulative no-all\",\n      questionId: questionId,\n      taskId: taskId,\n      handlesFoundInQuestion: $question.find(\"li.ui-sortable-handle\").length,\n      handlesFoundDocument: jQuery(\"li.ui-sortable-handle\").length,\n      currentOrder: getCurrentOrder(),\n      orderAtDragStart: orderAtDragStart,\n      rankProcess: getStored(KEY_PROCESS, \"\"),\n      taskMetadata: getStored(KEY_METADATA, \"\"),\n      taskCount: getStored(KEY_COUNT, \"0\")\n    };\n  };\n\n  window.DROPT_clearTestData = function () {\n    try {\n      Object.keys(sessionStorage)\n        .filter(function (k) { return k.indexOf(STORAGE_PREFIX) === 0; })\n        .forEach(function (k) { sessionStorage.removeItem(k); });\n    } catch (e) {}\n    setEmbeddedData(CONFIG.processField, \"\");\n    setEmbeddedData(CONFIG.metadataField, \"\");\n    setEmbeddedData(CONFIG.taskCountField, \"0\");\n    setEmbeddedData(CONFIG.submittedField, \"0\");\n    return \"DROPT test data cleared. Refresh\/restart the survey preview from the beginning.\";\n  };\n});\n\nQualtrics.SurveyEngine.addOnReady(function () {\n  if (window.console && console.log) {\n    console.log(\"DROPT question-level script ready.\");\n  }\n});","DefaultChoices":false,"DataExportTag":"ranking2","QuestionType":"RO","Selector":"DND","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"This is the rank-order question with some mock items. If any of the rank-order items are dragged...","Choices":{"1":{"Display":"Item 1"},"2":{"Display":"Item 2"},"3":{"Display":"Item 3"},"4":{"Display":"Item 4"}},"ChoiceOrder":[1,2,3,4],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":4,"QuestionID":"QID4"}},{"SurveyID":"SV_3IvOaR2kfI40hw2","Element":"SQ","PrimaryAttribute":"QID5","SecondaryAttribute":"This is the first rank-order question with some mock items. If any of the rank-order items are dr...","TertiaryAttribute":null,"Payload":{"QuestionText":"This is the first rank-order question with some mock items. If any of the rank-order items are dragged and dropped (and, importantly, change position!), this will be recorded in the embedded data fields. Once you download the data, all DROPT data will be downloaded as well.","DefaultChoices":false,"DataExportTag":"ranking1","QuestionID":"QID5","QuestionType":"RO","Selector":"DND","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"This is the first rank-order question with some mock items. If any of the rank-order items are dr...","Choices":{"1":{"Display":"Item 1"},"2":{"Display":"Item 2"},"3":{"Display":"Item 3"},"4":{"Display":"Item 4"},"5":{"Display":"Item 5"},"6":{"Display":"Item 6"}},"ChoiceOrder":[1,2,3,4,5,6],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionJS":"\/\/ DROPT JavaScript: question-level cumulative logger, embedded-data only\n\/\/\n\/\/ Placement: paste this SAME script into the JavaScript editor for each\n\/\/ Qualtrics rank-order question that should be recorded by DROPT.\n\/\/\n\/\/ Required Embedded Data fields in Survey Flow, before the rank-order questions:\n\/\/   DROPT_RankProcess\n\/\/   DROPT_TaskMetadata\n\/\/   DROPT_TaskCount\n\/\/   DROPT_Submitted\n\/\/\n\/\/ Main log format:\n\/\/   {DROPT1|0|NA|1,2,3,4,5}\n\/\/   {DROPT1|412,980|5|1,2,5,3,4}\n\/\/\n\/\/ Entry fields are:\n\/\/   {task_id|timing|item_moved|current_order}\n\/\/\n\nQualtrics.SurveyEngine.addOnload(function () {\n  var q = this;\n\n  var CONFIG = {\n    taskPrefix: \"DROPT\",\n    processField: \"DROPT_RankProcess\",\n    metadataField: \"DROPT_TaskMetadata\",\n    taskCountField: \"DROPT_TaskCount\",\n    submittedField: \"DROPT_Submitted\",\n    delayMs: 200,\n\n    debug: false\n  };\n\n  var submitted = 0;\n  var startTime = new Date().getTime();\n  var activeDrag = null;\n  var pendingDrag = null;\n  var rankCountThisQuestion = 0;\n  var lastTouchStartWallTime = 0;\n\n  var questionId = getQuestionId(q);\n  var namespace = \".dropt_\" + questionId.replace(\/[^A-Za-z0-9_\\-]\/g, \"_\");\n  var $question = getQuestionContainer(q, questionId);\n\n  \/\/ Prevent duplicate initialization for the same question on the same page.\n  if (window.__DROPT_initialized_questions === undefined) {\n    window.__DROPT_initialized_questions = {};\n  }\n  if (window.__DROPT_initialized_questions[questionId]) {\n    log(\"DROPT already initialized for this question on this page:\", questionId);\n    return;\n  }\n  window.__DROPT_initialized_questions[questionId] = true;\n\n  if (window.__DROPT_ED_STATE === undefined) {\n    window.__DROPT_ED_STATE = initializeStateFromEmbeddedData();\n  }\n  var state = window.__DROPT_ED_STATE;\n\n  var taskId = assignChronologicalTaskId(questionId);\n\n  initializeQuestion();\n\n  function initializeQuestion() {\n    var initialOrder = getCurrentOrder();\n\n    if (!validOrder(initialOrder)) {\n      log(\"DROPT did not find a valid rank order at load for\", questionId, initialOrder);\n      return;\n    }\n\n    appendInitialStateOnce(taskId, questionId, initialOrder);\n    setEmbeddedData(CONFIG.submittedField, \"0\");\n    syncStateToEmbeddedData();\n\n    log(\"DROPT initialized\", {\n      taskId: taskId,\n      questionId: questionId,\n      initialOrder: initialOrder,\n      process: state.process,\n      metadata: state.metadata,\n      taskCount: state.taskCount\n    });\n  }\n\n  function getQuestionId(questionObject) {\n    if (questionObject && questionObject.questionId) {\n      return String(questionObject.questionId);\n    }\n    if (questionObject && questionObject.getQuestionInfo) {\n      try {\n        var info = questionObject.getQuestionInfo();\n        if (info && info.QuestionID) return String(info.QuestionID);\n      } catch (e) {}\n    }\n    return \"DROPT_Q_\" + Math.floor(Math.random() * 1000000000);\n  }\n\n  function getQuestionContainer(questionObject, qid) {\n    var $container = jQuery();\n\n    if (questionObject && questionObject.getQuestionContainer) {\n      try {\n        $container = jQuery(questionObject.getQuestionContainer());\n      } catch (e) {}\n    }\n\n    if (!$container || $container.length === 0) {\n      $container = jQuery(\"#\" + qid);\n    }\n\n    if (!$container || $container.length === 0) {\n      $container = jQuery(document);\n    }\n\n    return $container;\n  }\n\n  function log() {\n    if (CONFIG.debug && window.console && console.log) {\n      console.log.apply(console, arguments);\n    }\n  }\n\n  function normalizeEmbeddedValue(value) {\n    if (value === undefined || value === null) return \"\";\n    value = String(value);\n    if (value === \"NA\" || value === \"undefined\" || value === \"null\") return \"\";\n    return value;\n  }\n\n  function getEmbeddedData(field) {\n    try {\n      if (Qualtrics.SurveyEngine.getEmbeddedData) {\n        return normalizeEmbeddedValue(Qualtrics.SurveyEngine.getEmbeddedData(field));\n      }\n    } catch (e) {\n      log(\"DROPT could not read embedded data\", field, e);\n    }\n    return \"\";\n  }\n\n  function setEmbeddedData(field, value) {\n    try {\n      Qualtrics.SurveyEngine.setEmbeddedData(field, String(value));\n    } catch (e) {\n      log(\"DROPT could not set embedded data\", field, e);\n    }\n  }\n\n  function initializeStateFromEmbeddedData() {\n    var process = getEmbeddedData(CONFIG.processField);\n    var metadata = getEmbeddedData(CONFIG.metadataField);\n    var rawCount = getEmbeddedData(CONFIG.taskCountField);\n    var taskCount = parseInt(rawCount, 10);\n    if (isNaN(taskCount)) taskCount = 0;\n\n    var questionToTask = {};\n    var maxTaskNumber = 0;\n    var entries = parseMetadata(metadata);\n\n    for (var i = 0; i < entries.length; i++) {\n      questionToTask[entries[i].questionId] = entries[i].taskId;\n      maxTaskNumber = Math.max(maxTaskNumber, taskNumber(entries[i].taskId));\n    }\n\n    taskCount = Math.max(taskCount, maxTaskNumber);\n\n    return {\n      process: process,\n      metadata: metadata,\n      taskCount: taskCount,\n      questionToTask: questionToTask\n    };\n  }\n\n  function parseMetadata(raw) {\n    var out = [];\n    raw = normalizeEmbeddedValue(raw);\n    if (!raw) return out;\n\n    var re = \/\\{([^|{}]+)\\|([^|{}]+)\\|([^{}]*)\\}\/g;\n    var m;\n    while ((m = re.exec(raw)) !== null) {\n      out.push({\n        taskId: String(m[1]),\n        questionId: String(m[2]),\n        order: String(m[3])\n      });\n    }\n    return out;\n  }\n\n  function taskNumber(task) {\n    var re = new RegExp(\"^\" + escapeRegExp(CONFIG.taskPrefix) + \"(\\\\d+)$\");\n    var m = re.exec(String(task));\n    if (!m) return 0;\n    var n = parseInt(m[1], 10);\n    return isNaN(n) ? 0 : n;\n  }\n\n  function syncStateToEmbeddedData() {\n    setEmbeddedData(CONFIG.processField, state.process || \"\");\n    setEmbeddedData(CONFIG.metadataField, state.metadata || \"\");\n    setEmbeddedData(CONFIG.taskCountField, String(state.taskCount || 0));\n  }\n\n  function assignChronologicalTaskId(qid) {\n    \/\/ Reuse an ID only if this question already appears in the current\n    \/\/ response's metadata. This handles accidental reload\/back-navigation within\n    \/\/ the same response, but avoids carrying mappings across preview runs.\n    if (state.questionToTask[qid]) {\n      return state.questionToTask[qid];\n    }\n\n    state.taskCount += 1;\n    var id = CONFIG.taskPrefix + state.taskCount;\n    state.questionToTask[qid] = id;\n    syncStateToEmbeddedData();\n    return id;\n  }\n\n  function getElapsedTime() {\n    return new Date().getTime() - startTime;\n  }\n\n  function hasScopedRankHandles() {\n    return $question && $question.length > 0 && $question.find(\"li.ui-sortable-handle\").length > 0;\n  }\n\n  function handleBelongsToThisQuestion($handle) {\n    if (!hasScopedRankHandles()) return true;\n    return $question[0] === $handle[0] || jQuery.contains($question[0], $handle[0]);\n  }\n\n  function getChoiceIdFromElement(el) {\n    var $li = jQuery(el).closest(\"li.ui-sortable-handle\");\n    var choiceId = $li.attr(\"data-choiceid\");\n    if (choiceId === undefined || choiceId === null || choiceId === \"\") {\n      choiceId = $li.data(\"choiceid\");\n    }\n    if (choiceId === undefined || choiceId === null || choiceId === \"\") {\n      choiceId = $li.attr(\"choiceid\");\n    }\n    if (choiceId === undefined || choiceId === null || choiceId === \"\") {\n      return \"NA\";\n    }\n    return String(choiceId);\n  }\n\n  function getCurrentOrder() {\n    var order = [];\n    var $handles = jQuery();\n\n    if (hasScopedRankHandles()) {\n      $handles = $question.find(\"li.ui-sortable-handle\");\n    } else {\n      \/\/ Fallback to the original DROPT selector.\n      $handles = jQuery(\"li.ui-sortable-handle\");\n    }\n\n    $handles.each(function () {\n      var choiceId = jQuery(this).attr(\"data-choiceid\");\n      if (choiceId === undefined || choiceId === null || choiceId === \"\") {\n        choiceId = jQuery(this).data(\"choiceid\");\n      }\n      if (choiceId !== undefined && choiceId !== null && String(choiceId) !== \"\") {\n        order.push(String(choiceId));\n      }\n    });\n\n    return order;\n  }\n\n  function arraysEqual(a, b) {\n    if (!a || !b) return false;\n    if (a.length !== b.length) return false;\n    for (var i = 0; i < a.length; i++) {\n      if (String(a[i]) !== String(b[i])) return false;\n    }\n    return true;\n  }\n\n  function validOrder(order) {\n    if (!order || order.length < 2) return false;\n    var seen = {};\n    for (var i = 0; i < order.length; i++) {\n      var value = String(order[i]);\n      if (value === \"\" || value === \"undefined\" || value === \"null\") return false;\n      if (seen[value]) return false;\n      seen[value] = true;\n    }\n    return true;\n  }\n\n  function escapeRegExp(s) {\n    return String(s).replace(\/[.*+?^${}()|[\\]\\\\]\/g, \"\\\\$&\");\n  }\n\n  function processEntry(task, timing, item, order) {\n    return \"{\" + task + \"|\" + timing + \"|\" + item + \"|\" + order.join(\",\") + \"}\";\n  }\n\n  function metadataEntry(task, qid, order) {\n    return \"{\" + task + \"|\" + qid + \"|\" + order.join(\",\") + \"}\";\n  }\n\n  function appendToProcess(entry) {\n    state.process = state.process ? state.process + \" \" + entry : entry;\n  }\n\n  function appendToMetadata(entry) {\n    state.metadata = state.metadata ? state.metadata + \" \" + entry : entry;\n  }\n\n  function processLogHasInitial(task) {\n    var pattern = new RegExp(\"\\\\{\" + escapeRegExp(task) + \"\\\\|0\\\\|NA\\\\|\");\n    return pattern.test(state.process || \"\");\n  }\n\n  function metadataHasTask(task) {\n    var pattern = new RegExp(\"\\\\{\" + escapeRegExp(task) + \"\\\\|\");\n    return pattern.test(state.metadata || \"\");\n  }\n\n  function appendInitialStateOnce(task, qid, order) {\n    if (!validOrder(order)) return;\n\n    if (!processLogHasInitial(task)) {\n      appendToProcess(processEntry(task, \"0\", \"NA\", order));\n    }\n\n    if (!metadataHasTask(task)) {\n      appendToMetadata(metadataEntry(task, qid, order));\n    }\n\n    syncStateToEmbeddedData();\n  }\n\n  function startDrag(event) {\n    if (submitted === 1) return;\n\n    \/\/ If the user starts another drag before the previous 200ms check fires,\n    \/\/ finalize the previous drag immediately using the order visible now. This\n    \/\/ is the main protection for very fast consecutive moves.\n    finalizePendingDrag(\"new_drag_started\");\n\n    var now = new Date().getTime();\n    if (event.type === \"mousedown\" && now - lastTouchStartWallTime < 500) {\n      return;\n    }\n    if (event.type === \"touchstart\") {\n      lastTouchStartWallTime = now;\n    }\n\n    var $handle = jQuery(event.target).closest(\"li.ui-sortable-handle\");\n    if ($handle.length === 0) return;\n    if (!handleBelongsToThisQuestion($handle)) return;\n\n    var currentOrder = getCurrentOrder();\n    if (!validOrder(currentOrder)) {\n      log(\"DROPT drag start ignored because current order is invalid:\", currentOrder);\n      return;\n    }\n\n    activeDrag = {\n      mouseDownTime: getElapsedTime(),\n      orderAtDragStart: currentOrder.slice(),\n      itemMoved: getChoiceIdFromElement($handle),\n      timeoutId: null\n    };\n\n    log(\"DROPT drag start\", {\n      taskId: taskId,\n      item: activeDrag.itemMoved,\n      time: activeDrag.mouseDownTime,\n      orderAtDragStart: activeDrag.orderAtDragStart\n    });\n  }\n\n  function endDrag() {\n    if (submitted === 1) return;\n    if (!activeDrag) return;\n\n    pendingDrag = {\n      mouseDownTime: activeDrag.mouseDownTime,\n      mouseUpTime: getElapsedTime(),\n      orderAtDragStart: activeDrag.orderAtDragStart.slice(),\n      itemMoved: activeDrag.itemMoved,\n      timeoutId: null\n    };\n    activeDrag = null;\n\n    pendingDrag.timeoutId = setTimeout(function () {\n      finalizePendingDrag(\"delay_elapsed\");\n    }, CONFIG.delayMs);\n  }\n\n  function finalizePendingDrag(reason) {\n    if (!pendingDrag) return;\n\n    if (pendingDrag.timeoutId !== null) {\n      clearTimeout(pendingDrag.timeoutId);\n    }\n\n    var drag = pendingDrag;\n    pendingDrag = null;\n\n    var finalOrder = getCurrentOrder();\n\n    if (!validOrder(finalOrder) || !validOrder(drag.orderAtDragStart)) {\n      log(\"DROPT drag ignored because an order was invalid\", {\n        reason: reason,\n        before: drag.orderAtDragStart,\n        final: finalOrder\n      });\n      return;\n    }\n\n    \/\/ Record this drag only if this specific drag changed the final rank order.\n    if (arraysEqual(finalOrder, drag.orderAtDragStart)) {\n      log(\"DROPT no rank-order change. Touch ignored.\", {\n        reason: reason,\n        taskId: taskId,\n        item: drag.itemMoved,\n        before: drag.orderAtDragStart,\n        final: finalOrder\n      });\n      return;\n    }\n\n    rankCountThisQuestion += 1;\n\n    var timing = String(drag.mouseDownTime) + \",\" + String(drag.mouseUpTime);\n    var entry = processEntry(taskId, timing, drag.itemMoved, finalOrder);\n\n    appendToProcess(entry);\n    syncStateToEmbeddedData();\n\n    log(\"DROPT recorded rank-order change\", {\n      reason: reason,\n      taskId: taskId,\n      rankCountThisQuestion: rankCountThisQuestion,\n      entry: entry,\n      process: state.process\n    });\n  }\n\n  document.addEventListener(\"mousedown\", startDrag, false);\n  document.addEventListener(\"mouseup\", endDrag, false);\n  document.addEventListener(\"touchstart\", startDrag, false);\n  document.addEventListener(\"touchend\", endDrag, false);\n\n  Qualtrics.SurveyEngine.addOnPageSubmit(function () {\n    finalizePendingDrag(\"page_submit\");\n    submitted = 1;\n    setEmbeddedData(CONFIG.submittedField, \"1\");\n    syncStateToEmbeddedData();\n\n    log(\"DROPT page submit\", {\n      taskId: taskId,\n      RankProcess: state.process,\n      TaskMetadata: state.metadata,\n      TaskCount: state.taskCount\n    });\n  });\n\n  Qualtrics.SurveyEngine.addOnUnload(function () {\n    try {\n      document.removeEventListener(\"mousedown\", startDrag, false);\n      document.removeEventListener(\"mouseup\", endDrag, false);\n      document.removeEventListener(\"touchstart\", startDrag, false);\n      document.removeEventListener(\"touchend\", endDrag, false);\n    } catch (e) {}\n  });\n\n  \/\/ Testing helpers. In Qualtrics preview, open the browser console and run\n  \/\/ DROPT_debug() after a rank-order question loads.\n  window.DROPT_debug = function () {\n    return {\n      version: \"DROPT question-level cumulative ED-only\",\n      questionId: questionId,\n      taskId: taskId,\n      handlesFoundInQuestion: $question.find(\"li.ui-sortable-handle\").length,\n      handlesFoundDocument: jQuery(\"li.ui-sortable-handle\").length,\n      currentOrder: getCurrentOrder(),\n      activeDrag: activeDrag,\n      pendingDrag: pendingDrag,\n      rankProcess: state.process,\n      taskMetadata: state.metadata,\n      taskCount: state.taskCount,\n      embeddedProcess: getEmbeddedData(CONFIG.processField),\n      embeddedMetadata: getEmbeddedData(CONFIG.metadataField),\n      embeddedTaskCount: getEmbeddedData(CONFIG.taskCountField)\n    };\n  };\n\n  window.DROPT_clearTestData = function () {\n    state.process = \"\";\n    state.metadata = \"\";\n    state.taskCount = 0;\n    state.questionToTask = {};\n    setEmbeddedData(CONFIG.processField, \"\");\n    setEmbeddedData(CONFIG.metadataField, \"\");\n    setEmbeddedData(CONFIG.taskCountField, \"0\");\n    setEmbeddedData(CONFIG.submittedField, \"0\");\n    return \"DROPT test data cleared for the current preview response. Refresh\/restart the survey preview from the beginning.\";\n  };\n});\n\nQualtrics.SurveyEngine.addOnReady(function () {\n  if (window.console && console.log) {\n    console.log(\"DROPT question-level ED-only script ready.\");\n  }\n});","Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"}}},{"SurveyID":"SV_3IvOaR2kfI40hw2","Element":"SQ","PrimaryAttribute":"QID6","SecondaryAttribute":"This is the second rank-order question with a different number of items. It works the same way as...","TertiaryAttribute":null,"Payload":{"QuestionText":"This is the second rank-order question with a different number of items. It works the same way as the prior question.","QuestionJS":"\/\/ DROPT JavaScript: question-level cumulative logger, embedded-data only\n\/\/\n\/\/ Placement: paste this SAME script into the JavaScript editor for each\n\/\/ Qualtrics rank-order question that should be recorded by DROPT.\n\/\/\n\/\/ Required Embedded Data fields in Survey Flow, before the rank-order questions:\n\/\/   DROPT_RankProcess\n\/\/   DROPT_TaskMetadata\n\/\/   DROPT_TaskCount\n\/\/   DROPT_Submitted\n\/\/\n\/\/ Main log format:\n\/\/   {DROPT1|0|NA|1,2,3,4,5}\n\/\/   {DROPT1|412,980|5|1,2,5,3,4}\n\/\/\n\/\/ Entry fields are:\n\/\/   {task_id|timing|item_moved|current_order}\n\/\/\n\nQualtrics.SurveyEngine.addOnload(function () {\n  var q = this;\n\n  var CONFIG = {\n    taskPrefix: \"DROPT\",\n    processField: \"DROPT_RankProcess\",\n    metadataField: \"DROPT_TaskMetadata\",\n    taskCountField: \"DROPT_TaskCount\",\n    submittedField: \"DROPT_Submitted\",\n    delayMs: 200,\n\n    debug: false\n  };\n\n  var submitted = 0;\n  var startTime = new Date().getTime();\n  var activeDrag = null;\n  var pendingDrag = null;\n  var rankCountThisQuestion = 0;\n  var lastTouchStartWallTime = 0;\n\n  var questionId = getQuestionId(q);\n  var namespace = \".dropt_\" + questionId.replace(\/[^A-Za-z0-9_\\-]\/g, \"_\");\n  var $question = getQuestionContainer(q, questionId);\n\n  \/\/ Prevent duplicate initialization for the same question on the same page.\n  if (window.__DROPT_initialized_questions === undefined) {\n    window.__DROPT_initialized_questions = {};\n  }\n  if (window.__DROPT_initialized_questions[questionId]) {\n    log(\"DROPT already initialized for this question on this page:\", questionId);\n    return;\n  }\n  window.__DROPT_initialized_questions[questionId] = true;\n\n  if (window.__DROPT_ED_STATE === undefined) {\n    window.__DROPT_ED_STATE = initializeStateFromEmbeddedData();\n  }\n  var state = window.__DROPT_ED_STATE;\n\n  var taskId = assignChronologicalTaskId(questionId);\n\n  initializeQuestion();\n\n  function initializeQuestion() {\n    var initialOrder = getCurrentOrder();\n\n    if (!validOrder(initialOrder)) {\n      log(\"DROPT did not find a valid rank order at load for\", questionId, initialOrder);\n      return;\n    }\n\n    appendInitialStateOnce(taskId, questionId, initialOrder);\n    setEmbeddedData(CONFIG.submittedField, \"0\");\n    syncStateToEmbeddedData();\n\n    log(\"DROPT initialized\", {\n      taskId: taskId,\n      questionId: questionId,\n      initialOrder: initialOrder,\n      process: state.process,\n      metadata: state.metadata,\n      taskCount: state.taskCount\n    });\n  }\n\n  function getQuestionId(questionObject) {\n    if (questionObject && questionObject.questionId) {\n      return String(questionObject.questionId);\n    }\n    if (questionObject && questionObject.getQuestionInfo) {\n      try {\n        var info = questionObject.getQuestionInfo();\n        if (info && info.QuestionID) return String(info.QuestionID);\n      } catch (e) {}\n    }\n    return \"DROPT_Q_\" + Math.floor(Math.random() * 1000000000);\n  }\n\n  function getQuestionContainer(questionObject, qid) {\n    var $container = jQuery();\n\n    if (questionObject && questionObject.getQuestionContainer) {\n      try {\n        $container = jQuery(questionObject.getQuestionContainer());\n      } catch (e) {}\n    }\n\n    if (!$container || $container.length === 0) {\n      $container = jQuery(\"#\" + qid);\n    }\n\n    if (!$container || $container.length === 0) {\n      $container = jQuery(document);\n    }\n\n    return $container;\n  }\n\n  function log() {\n    if (CONFIG.debug && window.console && console.log) {\n      console.log.apply(console, arguments);\n    }\n  }\n\n  function normalizeEmbeddedValue(value) {\n    if (value === undefined || value === null) return \"\";\n    value = String(value);\n    if (value === \"NA\" || value === \"undefined\" || value === \"null\") return \"\";\n    return value;\n  }\n\n  function getEmbeddedData(field) {\n    try {\n      if (Qualtrics.SurveyEngine.getEmbeddedData) {\n        return normalizeEmbeddedValue(Qualtrics.SurveyEngine.getEmbeddedData(field));\n      }\n    } catch (e) {\n      log(\"DROPT could not read embedded data\", field, e);\n    }\n    return \"\";\n  }\n\n  function setEmbeddedData(field, value) {\n    try {\n      Qualtrics.SurveyEngine.setEmbeddedData(field, String(value));\n    } catch (e) {\n      log(\"DROPT could not set embedded data\", field, e);\n    }\n  }\n\n  function initializeStateFromEmbeddedData() {\n    var process = getEmbeddedData(CONFIG.processField);\n    var metadata = getEmbeddedData(CONFIG.metadataField);\n    var rawCount = getEmbeddedData(CONFIG.taskCountField);\n    var taskCount = parseInt(rawCount, 10);\n    if (isNaN(taskCount)) taskCount = 0;\n\n    var questionToTask = {};\n    var maxTaskNumber = 0;\n    var entries = parseMetadata(metadata);\n\n    for (var i = 0; i < entries.length; i++) {\n      questionToTask[entries[i].questionId] = entries[i].taskId;\n      maxTaskNumber = Math.max(maxTaskNumber, taskNumber(entries[i].taskId));\n    }\n\n    taskCount = Math.max(taskCount, maxTaskNumber);\n\n    return {\n      process: process,\n      metadata: metadata,\n      taskCount: taskCount,\n      questionToTask: questionToTask\n    };\n  }\n\n  function parseMetadata(raw) {\n    var out = [];\n    raw = normalizeEmbeddedValue(raw);\n    if (!raw) return out;\n\n    var re = \/\\{([^|{}]+)\\|([^|{}]+)\\|([^{}]*)\\}\/g;\n    var m;\n    while ((m = re.exec(raw)) !== null) {\n      out.push({\n        taskId: String(m[1]),\n        questionId: String(m[2]),\n        order: String(m[3])\n      });\n    }\n    return out;\n  }\n\n  function taskNumber(task) {\n    var re = new RegExp(\"^\" + escapeRegExp(CONFIG.taskPrefix) + \"(\\\\d+)$\");\n    var m = re.exec(String(task));\n    if (!m) return 0;\n    var n = parseInt(m[1], 10);\n    return isNaN(n) ? 0 : n;\n  }\n\n  function syncStateToEmbeddedData() {\n    setEmbeddedData(CONFIG.processField, state.process || \"\");\n    setEmbeddedData(CONFIG.metadataField, state.metadata || \"\");\n    setEmbeddedData(CONFIG.taskCountField, String(state.taskCount || 0));\n  }\n\n  function assignChronologicalTaskId(qid) {\n    \/\/ Reuse an ID only if this question already appears in the current\n    \/\/ response's metadata. This handles accidental reload\/back-navigation within\n    \/\/ the same response, but avoids carrying mappings across preview runs.\n    if (state.questionToTask[qid]) {\n      return state.questionToTask[qid];\n    }\n\n    state.taskCount += 1;\n    var id = CONFIG.taskPrefix + state.taskCount;\n    state.questionToTask[qid] = id;\n    syncStateToEmbeddedData();\n    return id;\n  }\n\n  function getElapsedTime() {\n    return new Date().getTime() - startTime;\n  }\n\n  function hasScopedRankHandles() {\n    return $question && $question.length > 0 && $question.find(\"li.ui-sortable-handle\").length > 0;\n  }\n\n  function handleBelongsToThisQuestion($handle) {\n    if (!hasScopedRankHandles()) return true;\n    return $question[0] === $handle[0] || jQuery.contains($question[0], $handle[0]);\n  }\n\n  function getChoiceIdFromElement(el) {\n    var $li = jQuery(el).closest(\"li.ui-sortable-handle\");\n    var choiceId = $li.attr(\"data-choiceid\");\n    if (choiceId === undefined || choiceId === null || choiceId === \"\") {\n      choiceId = $li.data(\"choiceid\");\n    }\n    if (choiceId === undefined || choiceId === null || choiceId === \"\") {\n      choiceId = $li.attr(\"choiceid\");\n    }\n    if (choiceId === undefined || choiceId === null || choiceId === \"\") {\n      return \"NA\";\n    }\n    return String(choiceId);\n  }\n\n  function getCurrentOrder() {\n    var order = [];\n    var $handles = jQuery();\n\n    if (hasScopedRankHandles()) {\n      $handles = $question.find(\"li.ui-sortable-handle\");\n    } else {\n      \/\/ Fallback to the original DROPT selector.\n      $handles = jQuery(\"li.ui-sortable-handle\");\n    }\n\n    $handles.each(function () {\n      var choiceId = jQuery(this).attr(\"data-choiceid\");\n      if (choiceId === undefined || choiceId === null || choiceId === \"\") {\n        choiceId = jQuery(this).data(\"choiceid\");\n      }\n      if (choiceId !== undefined && choiceId !== null && String(choiceId) !== \"\") {\n        order.push(String(choiceId));\n      }\n    });\n\n    return order;\n  }\n\n  function arraysEqual(a, b) {\n    if (!a || !b) return false;\n    if (a.length !== b.length) return false;\n    for (var i = 0; i < a.length; i++) {\n      if (String(a[i]) !== String(b[i])) return false;\n    }\n    return true;\n  }\n\n  function validOrder(order) {\n    if (!order || order.length < 2) return false;\n    var seen = {};\n    for (var i = 0; i < order.length; i++) {\n      var value = String(order[i]);\n      if (value === \"\" || value === \"undefined\" || value === \"null\") return false;\n      if (seen[value]) return false;\n      seen[value] = true;\n    }\n    return true;\n  }\n\n  function escapeRegExp(s) {\n    return String(s).replace(\/[.*+?^${}()|[\\]\\\\]\/g, \"\\\\$&\");\n  }\n\n  function processEntry(task, timing, item, order) {\n    return \"{\" + task + \"|\" + timing + \"|\" + item + \"|\" + order.join(\",\") + \"}\";\n  }\n\n  function metadataEntry(task, qid, order) {\n    return \"{\" + task + \"|\" + qid + \"|\" + order.join(\",\") + \"}\";\n  }\n\n  function appendToProcess(entry) {\n    state.process = state.process ? state.process + \" \" + entry : entry;\n  }\n\n  function appendToMetadata(entry) {\n    state.metadata = state.metadata ? state.metadata + \" \" + entry : entry;\n  }\n\n  function processLogHasInitial(task) {\n    var pattern = new RegExp(\"\\\\{\" + escapeRegExp(task) + \"\\\\|0\\\\|NA\\\\|\");\n    return pattern.test(state.process || \"\");\n  }\n\n  function metadataHasTask(task) {\n    var pattern = new RegExp(\"\\\\{\" + escapeRegExp(task) + \"\\\\|\");\n    return pattern.test(state.metadata || \"\");\n  }\n\n  function appendInitialStateOnce(task, qid, order) {\n    if (!validOrder(order)) return;\n\n    if (!processLogHasInitial(task)) {\n      appendToProcess(processEntry(task, \"0\", \"NA\", order));\n    }\n\n    if (!metadataHasTask(task)) {\n      appendToMetadata(metadataEntry(task, qid, order));\n    }\n\n    syncStateToEmbeddedData();\n  }\n\n  function startDrag(event) {\n    if (submitted === 1) return;\n\n    \/\/ If the user starts another drag before the previous 200ms check fires,\n    \/\/ finalize the previous drag immediately using the order visible now. This\n    \/\/ is the main protection for very fast consecutive moves.\n    finalizePendingDrag(\"new_drag_started\");\n\n    var now = new Date().getTime();\n    if (event.type === \"mousedown\" && now - lastTouchStartWallTime < 500) {\n      return;\n    }\n    if (event.type === \"touchstart\") {\n      lastTouchStartWallTime = now;\n    }\n\n    var $handle = jQuery(event.target).closest(\"li.ui-sortable-handle\");\n    if ($handle.length === 0) return;\n    if (!handleBelongsToThisQuestion($handle)) return;\n\n    var currentOrder = getCurrentOrder();\n    if (!validOrder(currentOrder)) {\n      log(\"DROPT drag start ignored because current order is invalid:\", currentOrder);\n      return;\n    }\n\n    activeDrag = {\n      mouseDownTime: getElapsedTime(),\n      orderAtDragStart: currentOrder.slice(),\n      itemMoved: getChoiceIdFromElement($handle),\n      timeoutId: null\n    };\n\n    log(\"DROPT drag start\", {\n      taskId: taskId,\n      item: activeDrag.itemMoved,\n      time: activeDrag.mouseDownTime,\n      orderAtDragStart: activeDrag.orderAtDragStart\n    });\n  }\n\n  function endDrag() {\n    if (submitted === 1) return;\n    if (!activeDrag) return;\n\n    pendingDrag = {\n      mouseDownTime: activeDrag.mouseDownTime,\n      mouseUpTime: getElapsedTime(),\n      orderAtDragStart: activeDrag.orderAtDragStart.slice(),\n      itemMoved: activeDrag.itemMoved,\n      timeoutId: null\n    };\n    activeDrag = null;\n\n    pendingDrag.timeoutId = setTimeout(function () {\n      finalizePendingDrag(\"delay_elapsed\");\n    }, CONFIG.delayMs);\n  }\n\n  function finalizePendingDrag(reason) {\n    if (!pendingDrag) return;\n\n    if (pendingDrag.timeoutId !== null) {\n      clearTimeout(pendingDrag.timeoutId);\n    }\n\n    var drag = pendingDrag;\n    pendingDrag = null;\n\n    var finalOrder = getCurrentOrder();\n\n    if (!validOrder(finalOrder) || !validOrder(drag.orderAtDragStart)) {\n      log(\"DROPT drag ignored because an order was invalid\", {\n        reason: reason,\n        before: drag.orderAtDragStart,\n        final: finalOrder\n      });\n      return;\n    }\n\n    \/\/ Record this drag only if this specific drag changed the final rank order.\n    if (arraysEqual(finalOrder, drag.orderAtDragStart)) {\n      log(\"DROPT no rank-order change. Touch ignored.\", {\n        reason: reason,\n        taskId: taskId,\n        item: drag.itemMoved,\n        before: drag.orderAtDragStart,\n        final: finalOrder\n      });\n      return;\n    }\n\n    rankCountThisQuestion += 1;\n\n    var timing = String(drag.mouseDownTime) + \",\" + String(drag.mouseUpTime);\n    var entry = processEntry(taskId, timing, drag.itemMoved, finalOrder);\n\n    appendToProcess(entry);\n    syncStateToEmbeddedData();\n\n    log(\"DROPT recorded rank-order change\", {\n      reason: reason,\n      taskId: taskId,\n      rankCountThisQuestion: rankCountThisQuestion,\n      entry: entry,\n      process: state.process\n    });\n  }\n\n  document.addEventListener(\"mousedown\", startDrag, false);\n  document.addEventListener(\"mouseup\", endDrag, false);\n  document.addEventListener(\"touchstart\", startDrag, false);\n  document.addEventListener(\"touchend\", endDrag, false);\n\n  Qualtrics.SurveyEngine.addOnPageSubmit(function () {\n    finalizePendingDrag(\"page_submit\");\n    submitted = 1;\n    setEmbeddedData(CONFIG.submittedField, \"1\");\n    syncStateToEmbeddedData();\n\n    log(\"DROPT page submit\", {\n      taskId: taskId,\n      RankProcess: state.process,\n      TaskMetadata: state.metadata,\n      TaskCount: state.taskCount\n    });\n  });\n\n  Qualtrics.SurveyEngine.addOnUnload(function () {\n    try {\n      document.removeEventListener(\"mousedown\", startDrag, false);\n      document.removeEventListener(\"mouseup\", endDrag, false);\n      document.removeEventListener(\"touchstart\", startDrag, false);\n      document.removeEventListener(\"touchend\", endDrag, false);\n    } catch (e) {}\n  });\n\n  \/\/ Testing helpers. In Qualtrics preview, open the browser console and run\n  \/\/ DROPT_debug() after a rank-order question loads.\n  window.DROPT_debug = function () {\n    return {\n      version: \"DROPT question-level cumulative ED-only\",\n      questionId: questionId,\n      taskId: taskId,\n      handlesFoundInQuestion: $question.find(\"li.ui-sortable-handle\").length,\n      handlesFoundDocument: jQuery(\"li.ui-sortable-handle\").length,\n      currentOrder: getCurrentOrder(),\n      activeDrag: activeDrag,\n      pendingDrag: pendingDrag,\n      rankProcess: state.process,\n      taskMetadata: state.metadata,\n      taskCount: state.taskCount,\n      embeddedProcess: getEmbeddedData(CONFIG.processField),\n      embeddedMetadata: getEmbeddedData(CONFIG.metadataField),\n      embeddedTaskCount: getEmbeddedData(CONFIG.taskCountField)\n    };\n  };\n\n  window.DROPT_clearTestData = function () {\n    state.process = \"\";\n    state.metadata = \"\";\n    state.taskCount = 0;\n    state.questionToTask = {};\n    setEmbeddedData(CONFIG.processField, \"\");\n    setEmbeddedData(CONFIG.metadataField, \"\");\n    setEmbeddedData(CONFIG.taskCountField, \"0\");\n    setEmbeddedData(CONFIG.submittedField, \"0\");\n    return \"DROPT test data cleared for the current preview response. Refresh\/restart the survey preview from the beginning.\";\n  };\n});\n\nQualtrics.SurveyEngine.addOnReady(function () {\n  if (window.console && console.log) {\n    console.log(\"DROPT question-level ED-only script ready.\");\n  }\n});","DefaultChoices":false,"DataExportTag":"ranking2","QuestionType":"RO","Selector":"DND","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"This is the second rank-order question with a different number of items. It works the same way as...","Choices":{"1":{"Display":"Item 1"},"2":{"Display":"Item 2"},"3":{"Display":"Item 3"},"4":{"Display":"Item 4"}},"ChoiceOrder":[1,2,3,4],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID6"}},{"SurveyID":"SV_3IvOaR2kfI40hw2","Element":"SQ","PrimaryAttribute":"QID7","SecondaryAttribute":"This is the final DROPT question with yet another number of items. When creating new DROPT questi...","TertiaryAttribute":null,"Payload":{"QuestionText":"This is the final DROPT question with yet another number of items. When creating new DROPT questions, make sure to always add the JavaScript to each question; one set of embedded data fields is sufficient for all DROPT questions.","QuestionJS":"\/\/ DROPT JavaScript: question-level cumulative logger, embedded-data only\n\/\/\n\/\/ Placement: paste this SAME script into the JavaScript editor for each\n\/\/ Qualtrics rank-order question that should be recorded by DROPT.\n\/\/\n\/\/ Required Embedded Data fields in Survey Flow, before the rank-order questions:\n\/\/   DROPT_RankProcess\n\/\/   DROPT_TaskMetadata\n\/\/   DROPT_TaskCount\n\/\/   DROPT_Submitted\n\/\/\n\/\/ Main log format:\n\/\/   {DROPT1|0|NA|1,2,3,4,5}\n\/\/   {DROPT1|412,980|5|1,2,5,3,4}\n\/\/\n\/\/ Entry fields are:\n\/\/   {task_id|timing|item_moved|current_order}\n\/\/\n\nQualtrics.SurveyEngine.addOnload(function () {\n  var q = this;\n\n  var CONFIG = {\n    taskPrefix: \"DROPT\",\n    processField: \"DROPT_RankProcess\",\n    metadataField: \"DROPT_TaskMetadata\",\n    taskCountField: \"DROPT_TaskCount\",\n    submittedField: \"DROPT_Submitted\",\n    delayMs: 200,\n\n    debug: false\n  };\n\n  var submitted = 0;\n  var startTime = new Date().getTime();\n  var activeDrag = null;\n  var pendingDrag = null;\n  var rankCountThisQuestion = 0;\n  var lastTouchStartWallTime = 0;\n\n  var questionId = getQuestionId(q);\n  var namespace = \".dropt_\" + questionId.replace(\/[^A-Za-z0-9_\\-]\/g, \"_\");\n  var $question = getQuestionContainer(q, questionId);\n\n  \/\/ Prevent duplicate initialization for the same question on the same page.\n  if (window.__DROPT_initialized_questions === undefined) {\n    window.__DROPT_initialized_questions = {};\n  }\n  if (window.__DROPT_initialized_questions[questionId]) {\n    log(\"DROPT already initialized for this question on this page:\", questionId);\n    return;\n  }\n  window.__DROPT_initialized_questions[questionId] = true;\n\n  if (window.__DROPT_ED_STATE === undefined) {\n    window.__DROPT_ED_STATE = initializeStateFromEmbeddedData();\n  }\n  var state = window.__DROPT_ED_STATE;\n\n  var taskId = assignChronologicalTaskId(questionId);\n\n  initializeQuestion();\n\n  function initializeQuestion() {\n    var initialOrder = getCurrentOrder();\n\n    if (!validOrder(initialOrder)) {\n      log(\"DROPT did not find a valid rank order at load for\", questionId, initialOrder);\n      return;\n    }\n\n    appendInitialStateOnce(taskId, questionId, initialOrder);\n    setEmbeddedData(CONFIG.submittedField, \"0\");\n    syncStateToEmbeddedData();\n\n    log(\"DROPT initialized\", {\n      taskId: taskId,\n      questionId: questionId,\n      initialOrder: initialOrder,\n      process: state.process,\n      metadata: state.metadata,\n      taskCount: state.taskCount\n    });\n  }\n\n  function getQuestionId(questionObject) {\n    if (questionObject && questionObject.questionId) {\n      return String(questionObject.questionId);\n    }\n    if (questionObject && questionObject.getQuestionInfo) {\n      try {\n        var info = questionObject.getQuestionInfo();\n        if (info && info.QuestionID) return String(info.QuestionID);\n      } catch (e) {}\n    }\n    return \"DROPT_Q_\" + Math.floor(Math.random() * 1000000000);\n  }\n\n  function getQuestionContainer(questionObject, qid) {\n    var $container = jQuery();\n\n    if (questionObject && questionObject.getQuestionContainer) {\n      try {\n        $container = jQuery(questionObject.getQuestionContainer());\n      } catch (e) {}\n    }\n\n    if (!$container || $container.length === 0) {\n      $container = jQuery(\"#\" + qid);\n    }\n\n    if (!$container || $container.length === 0) {\n      $container = jQuery(document);\n    }\n\n    return $container;\n  }\n\n  function log() {\n    if (CONFIG.debug && window.console && console.log) {\n      console.log.apply(console, arguments);\n    }\n  }\n\n  function normalizeEmbeddedValue(value) {\n    if (value === undefined || value === null) return \"\";\n    value = String(value);\n    if (value === \"NA\" || value === \"undefined\" || value === \"null\") return \"\";\n    return value;\n  }\n\n  function getEmbeddedData(field) {\n    try {\n      if (Qualtrics.SurveyEngine.getEmbeddedData) {\n        return normalizeEmbeddedValue(Qualtrics.SurveyEngine.getEmbeddedData(field));\n      }\n    } catch (e) {\n      log(\"DROPT could not read embedded data\", field, e);\n    }\n    return \"\";\n  }\n\n  function setEmbeddedData(field, value) {\n    try {\n      Qualtrics.SurveyEngine.setEmbeddedData(field, String(value));\n    } catch (e) {\n      log(\"DROPT could not set embedded data\", field, e);\n    }\n  }\n\n  function initializeStateFromEmbeddedData() {\n    var process = getEmbeddedData(CONFIG.processField);\n    var metadata = getEmbeddedData(CONFIG.metadataField);\n    var rawCount = getEmbeddedData(CONFIG.taskCountField);\n    var taskCount = parseInt(rawCount, 10);\n    if (isNaN(taskCount)) taskCount = 0;\n\n    var questionToTask = {};\n    var maxTaskNumber = 0;\n    var entries = parseMetadata(metadata);\n\n    for (var i = 0; i < entries.length; i++) {\n      questionToTask[entries[i].questionId] = entries[i].taskId;\n      maxTaskNumber = Math.max(maxTaskNumber, taskNumber(entries[i].taskId));\n    }\n\n    taskCount = Math.max(taskCount, maxTaskNumber);\n\n    return {\n      process: process,\n      metadata: metadata,\n      taskCount: taskCount,\n      questionToTask: questionToTask\n    };\n  }\n\n  function parseMetadata(raw) {\n    var out = [];\n    raw = normalizeEmbeddedValue(raw);\n    if (!raw) return out;\n\n    var re = \/\\{([^|{}]+)\\|([^|{}]+)\\|([^{}]*)\\}\/g;\n    var m;\n    while ((m = re.exec(raw)) !== null) {\n      out.push({\n        taskId: String(m[1]),\n        questionId: String(m[2]),\n        order: String(m[3])\n      });\n    }\n    return out;\n  }\n\n  function taskNumber(task) {\n    var re = new RegExp(\"^\" + escapeRegExp(CONFIG.taskPrefix) + \"(\\\\d+)$\");\n    var m = re.exec(String(task));\n    if (!m) return 0;\n    var n = parseInt(m[1], 10);\n    return isNaN(n) ? 0 : n;\n  }\n\n  function syncStateToEmbeddedData() {\n    setEmbeddedData(CONFIG.processField, state.process || \"\");\n    setEmbeddedData(CONFIG.metadataField, state.metadata || \"\");\n    setEmbeddedData(CONFIG.taskCountField, String(state.taskCount || 0));\n  }\n\n  function assignChronologicalTaskId(qid) {\n    \/\/ Reuse an ID only if this question already appears in the current\n    \/\/ response's metadata. This handles accidental reload\/back-navigation within\n    \/\/ the same response, but avoids carrying mappings across preview runs.\n    if (state.questionToTask[qid]) {\n      return state.questionToTask[qid];\n    }\n\n    state.taskCount += 1;\n    var id = CONFIG.taskPrefix + state.taskCount;\n    state.questionToTask[qid] = id;\n    syncStateToEmbeddedData();\n    return id;\n  }\n\n  function getElapsedTime() {\n    return new Date().getTime() - startTime;\n  }\n\n  function hasScopedRankHandles() {\n    return $question && $question.length > 0 && $question.find(\"li.ui-sortable-handle\").length > 0;\n  }\n\n  function handleBelongsToThisQuestion($handle) {\n    if (!hasScopedRankHandles()) return true;\n    return $question[0] === $handle[0] || jQuery.contains($question[0], $handle[0]);\n  }\n\n  function getChoiceIdFromElement(el) {\n    var $li = jQuery(el).closest(\"li.ui-sortable-handle\");\n    var choiceId = $li.attr(\"data-choiceid\");\n    if (choiceId === undefined || choiceId === null || choiceId === \"\") {\n      choiceId = $li.data(\"choiceid\");\n    }\n    if (choiceId === undefined || choiceId === null || choiceId === \"\") {\n      choiceId = $li.attr(\"choiceid\");\n    }\n    if (choiceId === undefined || choiceId === null || choiceId === \"\") {\n      return \"NA\";\n    }\n    return String(choiceId);\n  }\n\n  function getCurrentOrder() {\n    var order = [];\n    var $handles = jQuery();\n\n    if (hasScopedRankHandles()) {\n      $handles = $question.find(\"li.ui-sortable-handle\");\n    } else {\n      \/\/ Fallback to the original DROPT selector.\n      $handles = jQuery(\"li.ui-sortable-handle\");\n    }\n\n    $handles.each(function () {\n      var choiceId = jQuery(this).attr(\"data-choiceid\");\n      if (choiceId === undefined || choiceId === null || choiceId === \"\") {\n        choiceId = jQuery(this).data(\"choiceid\");\n      }\n      if (choiceId !== undefined && choiceId !== null && String(choiceId) !== \"\") {\n        order.push(String(choiceId));\n      }\n    });\n\n    return order;\n  }\n\n  function arraysEqual(a, b) {\n    if (!a || !b) return false;\n    if (a.length !== b.length) return false;\n    for (var i = 0; i < a.length; i++) {\n      if (String(a[i]) !== String(b[i])) return false;\n    }\n    return true;\n  }\n\n  function validOrder(order) {\n    if (!order || order.length < 2) return false;\n    var seen = {};\n    for (var i = 0; i < order.length; i++) {\n      var value = String(order[i]);\n      if (value === \"\" || value === \"undefined\" || value === \"null\") return false;\n      if (seen[value]) return false;\n      seen[value] = true;\n    }\n    return true;\n  }\n\n  function escapeRegExp(s) {\n    return String(s).replace(\/[.*+?^${}()|[\\]\\\\]\/g, \"\\\\$&\");\n  }\n\n  function processEntry(task, timing, item, order) {\n    return \"{\" + task + \"|\" + timing + \"|\" + item + \"|\" + order.join(\",\") + \"}\";\n  }\n\n  function metadataEntry(task, qid, order) {\n    return \"{\" + task + \"|\" + qid + \"|\" + order.join(\",\") + \"}\";\n  }\n\n  function appendToProcess(entry) {\n    state.process = state.process ? state.process + \" \" + entry : entry;\n  }\n\n  function appendToMetadata(entry) {\n    state.metadata = state.metadata ? state.metadata + \" \" + entry : entry;\n  }\n\n  function processLogHasInitial(task) {\n    var pattern = new RegExp(\"\\\\{\" + escapeRegExp(task) + \"\\\\|0\\\\|NA\\\\|\");\n    return pattern.test(state.process || \"\");\n  }\n\n  function metadataHasTask(task) {\n    var pattern = new RegExp(\"\\\\{\" + escapeRegExp(task) + \"\\\\|\");\n    return pattern.test(state.metadata || \"\");\n  }\n\n  function appendInitialStateOnce(task, qid, order) {\n    if (!validOrder(order)) return;\n\n    if (!processLogHasInitial(task)) {\n      appendToProcess(processEntry(task, \"0\", \"NA\", order));\n    }\n\n    if (!metadataHasTask(task)) {\n      appendToMetadata(metadataEntry(task, qid, order));\n    }\n\n    syncStateToEmbeddedData();\n  }\n\n  function startDrag(event) {\n    if (submitted === 1) return;\n\n    \/\/ If the user starts another drag before the previous 200ms check fires,\n    \/\/ finalize the previous drag immediately using the order visible now. This\n    \/\/ is the main protection for very fast consecutive moves.\n    finalizePendingDrag(\"new_drag_started\");\n\n    var now = new Date().getTime();\n    if (event.type === \"mousedown\" && now - lastTouchStartWallTime < 500) {\n      return;\n    }\n    if (event.type === \"touchstart\") {\n      lastTouchStartWallTime = now;\n    }\n\n    var $handle = jQuery(event.target).closest(\"li.ui-sortable-handle\");\n    if ($handle.length === 0) return;\n    if (!handleBelongsToThisQuestion($handle)) return;\n\n    var currentOrder = getCurrentOrder();\n    if (!validOrder(currentOrder)) {\n      log(\"DROPT drag start ignored because current order is invalid:\", currentOrder);\n      return;\n    }\n\n    activeDrag = {\n      mouseDownTime: getElapsedTime(),\n      orderAtDragStart: currentOrder.slice(),\n      itemMoved: getChoiceIdFromElement($handle),\n      timeoutId: null\n    };\n\n    log(\"DROPT drag start\", {\n      taskId: taskId,\n      item: activeDrag.itemMoved,\n      time: activeDrag.mouseDownTime,\n      orderAtDragStart: activeDrag.orderAtDragStart\n    });\n  }\n\n  function endDrag() {\n    if (submitted === 1) return;\n    if (!activeDrag) return;\n\n    pendingDrag = {\n      mouseDownTime: activeDrag.mouseDownTime,\n      mouseUpTime: getElapsedTime(),\n      orderAtDragStart: activeDrag.orderAtDragStart.slice(),\n      itemMoved: activeDrag.itemMoved,\n      timeoutId: null\n    };\n    activeDrag = null;\n\n    pendingDrag.timeoutId = setTimeout(function () {\n      finalizePendingDrag(\"delay_elapsed\");\n    }, CONFIG.delayMs);\n  }\n\n  function finalizePendingDrag(reason) {\n    if (!pendingDrag) return;\n\n    if (pendingDrag.timeoutId !== null) {\n      clearTimeout(pendingDrag.timeoutId);\n    }\n\n    var drag = pendingDrag;\n    pendingDrag = null;\n\n    var finalOrder = getCurrentOrder();\n\n    if (!validOrder(finalOrder) || !validOrder(drag.orderAtDragStart)) {\n      log(\"DROPT drag ignored because an order was invalid\", {\n        reason: reason,\n        before: drag.orderAtDragStart,\n        final: finalOrder\n      });\n      return;\n    }\n\n    \/\/ Record this drag only if this specific drag changed the final rank order.\n    if (arraysEqual(finalOrder, drag.orderAtDragStart)) {\n      log(\"DROPT no rank-order change. Touch ignored.\", {\n        reason: reason,\n        taskId: taskId,\n        item: drag.itemMoved,\n        before: drag.orderAtDragStart,\n        final: finalOrder\n      });\n      return;\n    }\n\n    rankCountThisQuestion += 1;\n\n    var timing = String(drag.mouseDownTime) + \",\" + String(drag.mouseUpTime);\n    var entry = processEntry(taskId, timing, drag.itemMoved, finalOrder);\n\n    appendToProcess(entry);\n    syncStateToEmbeddedData();\n\n    log(\"DROPT recorded rank-order change\", {\n      reason: reason,\n      taskId: taskId,\n      rankCountThisQuestion: rankCountThisQuestion,\n      entry: entry,\n      process: state.process\n    });\n  }\n\n  document.addEventListener(\"mousedown\", startDrag, false);\n  document.addEventListener(\"mouseup\", endDrag, false);\n  document.addEventListener(\"touchstart\", startDrag, false);\n  document.addEventListener(\"touchend\", endDrag, false);\n\n  Qualtrics.SurveyEngine.addOnPageSubmit(function () {\n    finalizePendingDrag(\"page_submit\");\n    submitted = 1;\n    setEmbeddedData(CONFIG.submittedField, \"1\");\n    syncStateToEmbeddedData();\n\n    log(\"DROPT page submit\", {\n      taskId: taskId,\n      RankProcess: state.process,\n      TaskMetadata: state.metadata,\n      TaskCount: state.taskCount\n    });\n  });\n\n  Qualtrics.SurveyEngine.addOnUnload(function () {\n    try {\n      document.removeEventListener(\"mousedown\", startDrag, false);\n      document.removeEventListener(\"mouseup\", endDrag, false);\n      document.removeEventListener(\"touchstart\", startDrag, false);\n      document.removeEventListener(\"touchend\", endDrag, false);\n    } catch (e) {}\n  });\n\n  \/\/ Testing helpers. In Qualtrics preview, open the browser console and run\n  \/\/ DROPT_debug() after a rank-order question loads.\n  window.DROPT_debug = function () {\n    return {\n      version: \"DROPT question-level cumulative ED-only\",\n      questionId: questionId,\n      taskId: taskId,\n      handlesFoundInQuestion: $question.find(\"li.ui-sortable-handle\").length,\n      handlesFoundDocument: jQuery(\"li.ui-sortable-handle\").length,\n      currentOrder: getCurrentOrder(),\n      activeDrag: activeDrag,\n      pendingDrag: pendingDrag,\n      rankProcess: state.process,\n      taskMetadata: state.metadata,\n      taskCount: state.taskCount,\n      embeddedProcess: getEmbeddedData(CONFIG.processField),\n      embeddedMetadata: getEmbeddedData(CONFIG.metadataField),\n      embeddedTaskCount: getEmbeddedData(CONFIG.taskCountField)\n    };\n  };\n\n  window.DROPT_clearTestData = function () {\n    state.process = \"\";\n    state.metadata = \"\";\n    state.taskCount = 0;\n    state.questionToTask = {};\n    setEmbeddedData(CONFIG.processField, \"\");\n    setEmbeddedData(CONFIG.metadataField, \"\");\n    setEmbeddedData(CONFIG.taskCountField, \"0\");\n    setEmbeddedData(CONFIG.submittedField, \"0\");\n    return \"DROPT test data cleared for the current preview response. Refresh\/restart the survey preview from the beginning.\";\n  };\n});\n\nQualtrics.SurveyEngine.addOnReady(function () {\n  if (window.console && console.log) {\n    console.log(\"DROPT question-level ED-only script ready.\");\n  }\n});","DefaultChoices":false,"DataExportTag":"ranking3","QuestionType":"RO","Selector":"DND","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"This is the final DROPT question with yet another number of items. When creating new DROPT questi...","Choices":{"1":{"Display":"Item 1"},"2":{"Display":"Item 2"},"3":{"Display":"Item 3"}},"ChoiceOrder":[1,2,3],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"Q